IGNITION_VERSION=8.3.9
TZ=Europe/Warsaw

# Project bind-mount sources.
# Relative defaults are resolved from compose/compose.yml.
TEST_PROJECTS_PATH=../projects
DEV_PROJECTS_PATH=../services/ignition-dev/projects

# Root for Git-backed TEST Gateway resources.
TEST_GATEWAY_CONFIG_ROOT=../config/gateway/resources/core
TEST_CONFIG_RESOURCES_PATH=../runtime/test/config/resources

# DEV Gateway configuration runtime/deployment target.
DEV_CONFIG_RESOURCES_PATH=../services/ignition-dev/config/resources

TEST_GATEWAY_RESOURCES_ROOT=../config/gateway/resources