                  "props.selected": {
                    "onChange": {
                      "enabled": null,
                      "script": "\tif currentValue.value \u003d\u003d True: self.session.props.theme \u003d \u0027dark\u0027\n\telse: self.session.props.theme \u003d \u0027light\u0027"
